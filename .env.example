# MahaliShield Environment Configuration
APP_NAME="MahaliShield API"
ENVIRONMENT="development"

# Database (SQLite by default; switch to postgresql+psycopg://user:pass@host:5432/mahalishield for PostgreSQL)
DATABASE_URL="sqlite:///./mahalishield.db"

# Security
SECRET_KEY="replace-with-a-strong-random-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=720
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Open-Meteo Ensemble API
OPEN_METEO_ENSEMBLE_URL="https://ensemble-api.open-meteo.com/v1/ensemble"
OPEN_METEO_MODEL="icon_seamless"
WEATHER_TIMEOUT_S=12.0
WEATHER_STALE_AFTER_HOURS=6.0
CLUSTER_LAT=13.6889
CLUSTER_LON=75.2422

# OR-Tools CP-SAT Optimizer
SOLVER_TIME_LIMIT_S=10.0
SOLVER_WORKERS=8

# Optional Gemini API (for natural-language constraint parsing; deterministic template fallback works without it)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
