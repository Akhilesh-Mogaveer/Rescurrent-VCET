igate to=\"/login\" replace />;\n  }\n  return <>{children}</>;\n};\n\nconst RoleHomeRedirect: React.FC = () => {\n  const { user } = useApp();\n  if (user?.role === 'farmer') {\n    return <Navigate to=\"/grower\" replace />;\n  }\n  if (user?.role === 'admin') {\n    return <Navigate to=\"/governance\" replace />;\n  }\n  return <DashboardPage />;\n};\n\nconst RequireRole: React.FC<{\n  allowedRoles: ('coordinator' | 'farmer' | 'admin')[];\n  children: React.ReactNode;\n}> = ({ allowedRoles, children }) => {\n  const { user } = useApp();\n  if (!user) {\n    return <Navigate to=\"/login\" replace />;\n  }\n  if (!allowedRoles.includes(user.role)) {\n    return <Navigate to={getRoleHome(user.role)} replace />;\n  }\n  return <>{children}</>;\n};\n\nexport function App() {\n  return (\n    <ErrorBoundary>\n      <AppProvider>\n        <BrowserRouter>\n          <Routes>\n            <Route path=\"/login\" element={<AuthPage />} />\n            <Route\n              path=\"/\"\n              element={\n                <ProtectedRoute>\n                  <AppLayout />\n                </ProtectedRoute>\n              }\n            >\n              <Route index element={<RoleHomeRedirect />} />\n              <Route\n                path=\"grower\"\n                element={\n                  <RequireRole allowedRoles={['farmer']}>\n                    <GrowerHomePage />\n                  </RequireRole>\n                }\n              />\n              <Route\n                path=\"rain-gap\"\n                element={\n                  <RequireRole allowedRoles={['farmer', 'coordinator', 'admin']}>\n                    <RainGapPage />\n                  </RequireRole>\n                }\n              />\n              <Route\n                path=\"risk-twin\"\n                element={\n                  <RequireRole allowedRoles={['admin']}>\n                    <RiskTwinPage />\n                  </RequireRole>\n                }\n              />\n        